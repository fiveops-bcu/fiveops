{
  "title": "FiveOps Monitoring Dashboard",
  "uid": "fiveops-monitoring",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "tags": ["FiveOps", "Monitoring"],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Server Availability",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "fiveops-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"expr": "up{job=\"fiveops-servers\"}", "legendFormat": "{{instance}}", "refId": "A"}
      ]
    },
    {
      "id": 2,
      "title": "Application Health",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "fiveops-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "probe_success{job=\"fiveops-application\"}", "legendFormat": "{{instance}}", "refId": "A"}
      ]
    },
    {
      "id": 3,
      "title": "CPU Usage (%)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "fiveops-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "100 - (avg by(instance)(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "{{instance}}", "refId": "A"}
      ]
    },
    {
      "id": 4,
      "title": "Memory Usage (%)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "fiveops-prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "legendFormat": "{{instance}}", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "title": "Application Response Time (seconds)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "fiveops-prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "targets": [
        {"expr": "probe_duration_seconds{job=\"fiveops-application\"}", "legendFormat": "{{instance}}", "refId": "A"}
      ]
      },
    {
      "id": 6,
      "title": "Flask HTTP Request Rate (requests/sec)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "fiveops-prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
      "targets": [
        {
          "expr": "sum(rate(flask_http_request_total{job=\"fiveops-flask-metrics\"}[5m]))",
          "legendFormat": "HTTP requests/sec",
          "refId": "A"
        }
      ]
    }
  ]
}
